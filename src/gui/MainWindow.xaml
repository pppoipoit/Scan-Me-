<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan Me! - Next-Gen File Scanner &amp; Skill Tree Engine"
        Height="780" Width="1140"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI, Segoe UI Variable Display, sans-serif">

    <Window.Resources>
        <!-- Gradients and Brushes -->
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#06B6D4" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="0.5"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ScanButtonGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10B981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="CardBackground" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#334155"/>
        <SolidColorBrush x:Key="InputBackground" Color="#0F172A"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#06B6D4"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentRose" Color="#F43F5E"/>
        <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>

        <!-- Drop Shadow Effect for Dropdown -->
        <DropShadowEffect x:Key="DropShadowEffect" Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.3" Direction="270"/>

        <!-- Common Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#475569"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glow Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ScanButtonGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackground}"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#06B6D4"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="txtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="txtBorder" Property="BorderBrush" Value="#06B6D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark Rounded ComboBox ToggleButton -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8"
                        Background="#0F172A" BorderBrush="#334155" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#38BDF8" HorizontalAlignment="Center"
                      VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z" Margin="0,1,6,0" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="Border" Property="Background" Value="#172033"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="#06B6D4"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4"/>
                    <Setter TargetName="Border" Property="Background" Value="#172033"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Custom Dark Rounded ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Main Content Area -->
                            <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="8"
                                    Background="#0F172A" BorderBrush="#334155" BorderThickness="1" />
                            <ContentPresenter Name="ContentSite" Grid.Column="0" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <!-- Dropdown Toggle Button (Arrow) -->
                            <ToggleButton Name="PART_ToggleButton" Grid.Column="1" Width="40"
                                          Template="{StaticResource DarkComboBoxToggleButton}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Release"
                                          Cursor="Hand"
                                          Panel.ZIndex="100"
                                          IsHitTestVisible="True" />

                            <!-- Dropdown Popup -->
                            <Popup Name="PART_Popup" Grid.ColumnSpan="2" Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" 
                                   PopupAnimation="Slide" StaysOpen="False"
                                   Popup.PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1E293B" BorderThickness="1"
                                            BorderBrush="#06B6D4" CornerRadius="8" Margin="0,2,0,0"
                                            Effect="{StaticResource DropShadowEffect}">
                                        <ScrollViewer Margin="2,3" SnapsToDevicePixels="True" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4" />
                                <Setter TargetName="Border" Property="Background" Value="#172033" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4" />
                                <Setter TargetName="Border" Property="Background" Value="#172033" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#06B6D4" />
                                <Setter TargetName="Border" Property="Background" Value="#172033" />
                                <Setter TargetName="Border" Property="CornerRadius" Value="8,8,0,0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                                <Setter TargetName="ContentSite" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Dark ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="1,1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#0284C7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="RowBackground" Value="#1E293B"/>
            <Setter Property="AlternatingRowBackground" Value="#172033"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Stat Cards -->
            <RowDefinition Height="Auto"/> <!-- Controls & Options -->
            <RowDefinition Height="*"/>    <!-- Data Table & Search -->
            <RowDefinition Height="Auto"/> <!-- Action Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Image x:Name="AppLogo" Width="40" Height="40" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="SCAN ME!" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource HeaderGradient}" VerticalAlignment="Center"/>
                    <Border Background="#0284C7" CornerRadius="4" Padding="6,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0 Pro" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="High-Performance File Intelligence, Categorization &amp; Skill-Tree Cataloger"
                           FontSize="12" Foreground="{StaticResource TextMuted}" Margin="36,3,0,0"/>
            </StackPanel>

            <!-- Status Indicator Badge -->
            <Border Grid.Column="1" x:Name="StatusBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                    CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Ready to Scan" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Stat Cards Grid -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Files -->
            <Border Grid.Column="0" Margin="0,0,8,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL FILES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="LblTotalFiles" Text="0" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Size -->
            <Border Grid.Column="1" Margin="4,0,4,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL STORAGE" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="LblTotalSize" Text="0 MB" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Categories / Extensions -->
            <Border Grid.Column="2" Margin="4,0,4,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="CATEGORIES / TYPES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="LblCategoryCount" Text="0 Types" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Duplicates Found -->
            <Border Grid.Column="3" Margin="8,0,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="DUPLICATE FILES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock x:Name="LblDuplicateCount" Text="0 (0 MB)" FontSize="20" FontWeight="Bold" Foreground="#FB7185" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Target Configuration & Options Box -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <!-- Row A: Folder Picker -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Target Folder:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0" Foreground="#E2E8F0"/>
                    <TextBox Grid.Column="1" x:Name="TxtTargetFolder" Text="E:\Project\Scan Me!" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" x:Name="BtnBrowseTarget" Content="📁 Browse..."/>
                </Grid>

                <!-- Row B: Filter Preset & Custom Extensions -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Filter Preset:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,14,0" Foreground="#E2E8F0"/>
                    <ComboBox Grid.Column="1" x:Name="CmbPresets" Margin="0,0,16,0">
                        <ComboBoxItem Content="🌐 All Files (*.*)" IsSelected="True"/>
                        <ComboBoxItem Content="📦 Installers &amp; Packages"/>
                        <ComboBoxItem Content="💻 Code &amp; Dev Files"/>
                        <ComboBoxItem Content="📄 Documents &amp; Office"/>
                        <ComboBoxItem Content="🎨 Media (Images/Video)"/>
                        <ComboBoxItem Content="⚙️ Custom Extensions"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Extensions:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#E2E8F0"/>
                    <TextBox Grid.Column="3" x:Name="TxtExtensions" Text="*.*" ToolTip="Separate by comma or space, e.g. *.exe, *.zip, *.pdf"/>
                </Grid>

                <!-- Row C: Options Checkboxes -->
                <WrapPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <CheckBox x:Name="ChkAllFiles" Content="🌟 Scan All Files" IsChecked="True" Margin="0,0,22,0"/>
                    <CheckBox x:Name="ChkDuplicateHash" Content="🔍 Check Duplicates (MD5 Hash)" IsChecked="False" Margin="0,0,22,0" ToolTip="Calculates MD5 checksum to detect identical files"/>
                    <CheckBox x:Name="ChkExeMetadata" Content="🏷️ Extract EXE/App Version &amp; Metadata" IsChecked="False" Margin="0,0,22,0" ToolTip="Reads file version, company name, and description from binaries"/>
                    <CheckBox x:Name="ChkHiddenFiles" Content="👁️ Include Hidden Files" IsChecked="False" Margin="0,0,0,0"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 4. DataGrid & Live Search -->
        <Border Grid.Row="3" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Search & Filter Header -->
                    <RowDefinition Height="*"/>    <!-- DataGrid -->
                </Grid.RowDefinitions>

                <!-- Search Bar & Table Action -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="🔍 Quick Filter:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" Foreground="{StaticResource TextMuted}"/>
                    <TextBox Grid.Column="1" x:Name="TxtSearchFilter" Text="" ToolTip="Type to filter file name, category, or path..."/>
                    <TextBlock Grid.Column="2" x:Name="LblRecordStatus" Text="0 items listed" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <Button Grid.Column="3" x:Name="BtnClearTable" Content="🧹 Clear Results" Padding="10,4"/>
                </Grid>

                <!-- Main Data Grid -->
                <DataGrid Grid.Row="1" x:Name="GridResults">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="📁 Category" Binding="{Binding Category_Folder}" Width="130"/>
                        <DataGridTextColumn Header="📄 File Name" Binding="{Binding File_Name}" Width="190"/>
                        <DataGridTextColumn Header="🏷️ Ext" Binding="{Binding Extension}" Width="65"/>
                        <DataGridTextColumn Header="💾 Size" Binding="{Binding Size_Formatted}" Width="85"/>
                        <DataGridTextColumn Header="🔢 MB" Binding="{Binding Size_MB}" Width="65"/>
                        <DataGridTextColumn Header="⚠️ Duplicate?" Binding="{Binding DuplicateBadge}" Width="90"/>
                        <DataGridTextColumn Header="🏷️ Version/Company" Binding="{Binding MetaInfo}" Width="150"/>
                        <DataGridTextColumn Header="📅 Last Modified" Binding="{Binding LastModified}" Width="135"/>
                        <DataGridTextColumn Header="📍 Full Path" Binding="{Binding Full_Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 5. Footer & Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Progress Bar & Status Text -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <ProgressBar x:Name="ScanProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" Background="#1E293B" Foreground="{StaticResource AccentCyan}" BorderThickness="0"/>
                <TextBlock x:Name="LblProgressDetail" Text="Ready to start scanning" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Action Buttons Group -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnExportJson" Content="💾 JSON" Margin="0,0,6,0" IsEnabled="False" ToolTip="Export full structured JSON (SkillTree schema) for other apps"/>
                <Button x:Name="BtnExportCsv" Content="📊 CSV" Margin="0,0,6,0" IsEnabled="False" ToolTip="Export flat list as CSV spreadsheet"/>
                <Button x:Name="BtnExportHtmlTree" Content="🌲 Tree (HTML)" Margin="0,0,6,0" IsEnabled="False" ToolTip="Export interactive root tree with scroll, search, copy &amp; collapse/expand"/>
                <Button x:Name="BtnExportTxtTree" Content="📄 Tree (TXT)" Margin="0,0,6,0" IsEnabled="False" ToolTip="Export clean ASCII tree structure as plain text/markdown"/>
                <Button x:Name="BtnOpenOutput" Content="📂 Output" Margin="0,0,10,0" ToolTip="Open output folder"/>
                <Button x:Name="BtnStartScan" Style="{StaticResource PrimaryButton}" Content="🚀 START SCAN"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>