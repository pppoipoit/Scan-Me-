{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "🚀 Launch Scan Me! GUI",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -File \"${workspaceFolder}\\src\\gui\\MainWindow.ps1\"",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        },
        {
            "label": "⚡ Quick CLI Scan (Current Directory)",
            "type": "shell",
            "command": "powershell.exe -ExecutionPolicy Bypass -Command \"& '${workspaceFolder}\\src\\engine\\Scanner.ps1' -TargetFolder '${workspaceFolder}' -OutputFile '${workspaceFolder}\\output\\quick_scan.json' -IncludeAllFiles\"",
            "problemMatcher": [],
            "group": "test"
        }
    ]
}
